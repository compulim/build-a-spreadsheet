{
  "name": "@compulm/build-a-spreadsheet",
  "version": "0.0.0",
  "private": true,
  "description": "A high-performance, purely client-side spreadsheet web app.",
  "type": "module",
  "scripts": {
    "browser": "npx --offline @onting/browser http://localhost:3000/html/simple",
    "build": "tsup",
    "start": "concurrently --color --kill-others \"npm run start:*\"",
    "start:build": "nodemon --exec \"npm run build\" --watch \"./package.json\" --watch \"./src/**/*\" --watch \"./tsup.config.ts\"",
    "start:serve": "npx --yes serve ./public/",
    "test": "node --test",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@onting/browser": "^0.1.1-main.202610251852.46007c3",
    "@onting/harness": "^0.1.1-main.202610260624.2f80011",
    "@onting/stub": "^0.1.0-main.202610251830.dda9781",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "is-ci": "^4.1.0",
    "nodemon": "^3.1.14",
    "serve": "^14.2.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@primer/octicons-react": "^19.41.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.42.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1"
  }
}
